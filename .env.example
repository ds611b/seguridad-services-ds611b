# ========================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ========================================

# Puerto donde correrá el servidor
PORT=

# Host/dirección IP del servidor (0.0.0.0 para permitir conexiones externas)
HOST=

# Entorno de ejecución (development, production, test)
NODE_ENV=

# Ruta donde se servirá la documentación de la API
DOCS_PATH=

# Nivel de logging (trace, debug, info, warn, error, fatal)
LOG_LEVEL=

# ========================================
# BASE DE DATOS
# ========================================

# Nombre de la base de datos
DB_NAME=

# Usuario de la base de datos
DB_USER=

# Contraseña de la base de datos
DB_PASSWORD=

# Host/IP de la base de datos
DB_HOST=

# ========================================
# JWT (JSON WEB TOKENS)
# ========================================

# Secreto para firmar los tokens JWT (usar string aleatorio largo y seguro)
JWT_SECRET=

# Tiempo de expiración de los Access Tokens JWT (ej: 30s, 15m, 1h)
JWT_ACCESS_EXPIRES=

# ========================================
# EMAIL
# ========================================

# Modo de envío:
#   smtp → nodemailer (desarrollo local o servidores que permiten SMTP)
#   api  → Brevo HTTP API (PaaS que bloquean puertos SMTP)
EMAIL_MODE=smtp

# ── Modo SMTP (EMAIL_MODE=smtp) ──────────────────────────────────────────────
# Servidor SMTP (ej: smtp-relay.brevo.com, smtp.gmail.com)
SMTP_HOST=

# Puerto SMTP (587 = STARTTLS, 465 = SSL, 2525 = alternativo)
SMTP_PORT=587

# Usuario SMTP
SMTP_USER=

# Contraseña SMTP
SMTP_PASS=

# Remitente (ej: "ConnectPro <no-reply@itca.edu.sv>")
EMAIL_FROM=

# ── Modo API (EMAIL_MODE=api) ────────────────────────────────────────────────
# API Key v3 de Brevo (brevo.com → SMTP & API → API Keys, empieza con xkeysib-)
BREVO_API_KEY=

# Correo remitente verificado en Brevo
EMAIL_FROM_ADDRESS=

# ========================================
# FRONTEND
# ========================================

# URL base del frontend (para construir el link de reset de contraseña)
APP_URL=http://localhost:4200
